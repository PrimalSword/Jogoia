#!/bin/sh

hostname orbis 2>/dev/null || true
mkdir -p /var/log /run
mount -o remount,rw / 2>/dev/null || true

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf boot)" "$*" >> /var/log/orbis.log 2>/dev/null || true; }
apply_saved_keyboard() {
  [ -f /etc/orbis-keyboard ] || return 0; . /etc/orbis-keyboard 2>/dev/null || return 0
  layout="${ORBIS_KEYBOARD:-}"; [ -n "$layout" ] || return 0; KEYMAP_DIR="/usr/share/bkeymaps"
  case "$layout" in br-abnt2) candidate="$(find "$KEYMAP_DIR" -type f \( -name 'br-abnt2.bmap.gz' -o -name 'br-abnt2.bmap' -o -name 'br*.bmap.gz' \) 2>/dev/null | head -n1)" ;; us) candidate="$(find "$KEYMAP_DIR" -type f \( -name 'us.bmap.gz' -o -name 'us.bmap' \) 2>/dev/null | head -n1)" ;; *) return 0 ;; esac
  if [ -n "$candidate" ] && command -v loadkmap >/dev/null 2>&1; then case "$candidate" in *.gz) gzip -dc "$candidate" | loadkmap ;; *) loadkmap < "$candidate" ;; esac; log "Teclado aplicado: $layout"; fi
}
find_wifi_iface() { WIFI_IFACE=""; count=0; while [ "$count" -lt 15 ]; do for path in /sys/class/net/*; do [ -e "$path" ] || continue; iface="${path##*/}"; case "$iface" in wlan*|wlp*) WIFI_IFACE="$iface"; return 0 ;; esac; done; count=$((count + 1)); sleep 1; done; return 1; }
auto_connect_wifi() {
  CONF="/etc/wpa_supplicant/wpa_supplicant.conf"; [ -s "$CONF" ] || { log 'Wi-Fi automático: nenhuma configuração salva.'; return 0; }
  command -v modprobe >/dev/null 2>&1 && modprobe ath9k 2>/dev/null || true; command -v rfkill >/dev/null 2>&1 && rfkill unblock all 2>/dev/null || true
  find_wifi_iface || { log 'Wi-Fi automático: interface não encontrada.'; return 0; }
  ifconfig "$WIFI_IFACE" up 2>/dev/null || ip link set "$WIFI_IFACE" up 2>/dev/null || true
  if ! iw dev "$WIFI_IFACE" link 2>/dev/null | grep -q '^Connected to '; then killall wpa_supplicant 2>/dev/null || true; wpa_supplicant -B -i "$WIFI_IFACE" -c "$CONF" >/dev/null 2>&1 || return 0; sleep 5; fi
  ip -4 -o addr show dev "$WIFI_IFACE" scope global 2>/dev/null | grep -q 'inet ' || udhcpc -i "$WIFI_IFACE" -q -t 5 -T 3 >/dev/null 2>&1 || true
}
sync_clock() { [ -x /usr/local/bin/orbis-time ] && /usr/local/bin/orbis-time --quiet || true; }
run_boot_automations() { [ -x /usr/local/bin/orbis-jobs ] && /usr/local/bin/orbis-jobs --boot >/dev/null 2>&1 || true; }
start_web_dashboard() { [ -x /usr/local/bin/orbis-web ] && /usr/local/bin/orbis-web --boot >/dev/null 2>&1 || true; }
start_remote_access() { [ -x /usr/local/bin/orbis-remote ] && /usr/local/bin/orbis-remote --boot >/dev/null 2>&1 || true; }

log "OrbisOS iniciou em $(uname -r)"
apply_saved_keyboard
auto_connect_wifi
sync_clock
start_remote_access
run_boot_automations
start_web_dashboard
if [ -x /usr/local/bin/orbis ]; then /usr/local/bin/orbis; fi
exec /bin/ash -l
