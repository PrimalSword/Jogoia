#!/bin/sh

hostname orbis 2>/dev/null || true
mkdir -p /var/log /run
mount -o remount,rw / 2>/dev/null || true

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf boot)" "$*" >> /var/log/orbis.log 2>/dev/null || true
}

apply_saved_keyboard() {
  [ -f /etc/orbis-keyboard ] || return 0
  . /etc/orbis-keyboard 2>/dev/null || return 0
  layout="${ORBIS_KEYBOARD:-}"
  [ -n "$layout" ] || return 0
  KEYMAP_DIR="/usr/share/bkeymaps"
  case "$layout" in
    br-abnt2) candidate="$(find "$KEYMAP_DIR" -type f \( -name 'br-abnt2.bmap.gz' -o -name 'br-abnt2.bmap' -o -name 'br*.bmap.gz' \) 2>/dev/null | head -n1)" ;;
    us) candidate="$(find "$KEYMAP_DIR" -type f \( -name 'us.bmap.gz' -o -name 'us.bmap' \) 2>/dev/null | head -n1)" ;;
    *) return 0 ;;
  esac
  if [ -n "$candidate" ] && command -v loadkmap >/dev/null 2>&1; then
    case "$candidate" in *.gz) gzip -dc "$candidate" | loadkmap ;; *) loadkmap < "$candidate" ;; esac
    log "Teclado aplicado: $layout"
  fi
}

find_wifi_iface() {
  WIFI_IFACE=""
  count=0
  while [ "$count" -lt 15 ]; do
    for path in /sys/class/net/*; do
      [ -e "$path" ] || continue
      iface="${path##*/}"
      case "$iface" in wlan*|wlp*) WIFI_IFACE="$iface"; return 0 ;; esac
    done
    count=$((count + 1))
    sleep 1
  done
  return 1
}

auto_connect_wifi() {
  CONF="/etc/wpa_supplicant/wpa_supplicant.conf"
  [ -s "$CONF" ] || { log 'Wi-Fi automático: nenhuma configuração salva.'; return 0; }

  command -v modprobe >/dev/null 2>&1 && modprobe ath9k 2>/dev/null || true
  command -v rfkill >/dev/null 2>&1 && rfkill unblock all 2>/dev/null || true

  if ! find_wifi_iface; then log 'Wi-Fi automático: interface não encontrada após 15 segundos.'; return 0; fi
  ifconfig "$WIFI_IFACE" up 2>/dev/null || ip link set "$WIFI_IFACE" up 2>/dev/null || true

  if ! iw dev "$WIFI_IFACE" link 2>/dev/null | grep -q '^Connected to '; then
    killall wpa_supplicant 2>/dev/null || true
    rm -f /run/orbis-wpa.pid
    wpa_supplicant -B -P /run/orbis-wpa.pid -i "$WIFI_IFACE" -c "$CONF" >/dev/null 2>&1 || { log "Wi-Fi automático: falha ao iniciar wpa_supplicant em $WIFI_IFACE."; return 0; }
    count=0
    while [ "$count" -lt 15 ]; do
      iw dev "$WIFI_IFACE" link 2>/dev/null | grep -q '^Connected to ' && break
      count=$((count + 1)); sleep 1
    done
  fi

  if ! ip -4 -o addr show dev "$WIFI_IFACE" scope global 2>/dev/null | grep -q 'inet '; then
    if command -v timeout >/dev/null 2>&1; then timeout 20 udhcpc -i "$WIFI_IFACE" -q -t 5 -T 3 >/dev/null 2>&1 || true
    else udhcpc -i "$WIFI_IFACE" -q -t 5 -T 3 >/dev/null 2>&1 || true; fi
  fi

  IP="$(ip -4 -o addr show dev "$WIFI_IFACE" scope global 2>/dev/null | awk '{print $4}' | head -n1)"
  SSID="$(iw dev "$WIFI_IFACE" link 2>/dev/null | awk -F': ' '/SSID:/ {print $2; exit}')"
  [ -n "$IP" ] && log "Wi-Fi automático conectado: interface=$WIFI_IFACE ssid=${SSID:-desconhecida} ip=$IP" || log "Wi-Fi automático sem IP: interface=$WIFI_IFACE"
}

sync_clock() {
  [ -x /usr/local/bin/orbis-time ] || return 0
  /usr/local/bin/orbis-time --quiet || true
}

log "OrbisOS iniciou em $(uname -r)"
apply_saved_keyboard
auto_connect_wifi
sync_clock

if [ -x /usr/local/bin/orbis ]; then /usr/local/bin/orbis; fi
exec /bin/ash -l
