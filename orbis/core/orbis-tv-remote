PIN_FILE = STATE_DIR / "pin"
PID_FILE = Path("/run/orbis-tv-remote.pid")
LOG_FILE = Path("/var/log/orbis-tv-remote.log")

ALLOWED_KEYS = {
    "Return", "Escape", "BackSpace", "Tab", "Up", "Down", "Left", "Right",
    "space", "Home", "End", "Page_Up", "Page_Down",
    "XF86AudioPlay", "XF86AudioPause", "XF86AudioStop",
