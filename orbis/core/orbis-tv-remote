  async function api(payload) {
    payload.pin = pin;
    const r = await fetch('/api/action', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body:JSON.stringify(payload)
    });
    const j = await r.json().catch(()=>({ok:false,error:'Resposta inválida'}));
