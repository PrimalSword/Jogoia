def ensure_state():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    if not PIN_FILE.exists():
        PIN_FILE.write_text(f"{secrets.randbelow(1000000):06d}\n")
        os.chmod(PIN_FILE, 0o600)
    return PIN_FILE.read_text().strip()

def get_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("1.1.1.1", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return "127.0.0.1"

def run(cmd, stdin_text=None):
    env = os.environ.copy()
    env["DISPLAY"] = DISPLAY
    return subprocess.run(
        cmd, input=stdin_text, text=True, env=env,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=4, check=False
    ).returncode == 0

def xdotool(*args):
    return run(["xdotool", *args])

def change_volume(direction):
    controls = ["Master", "Headphone", "PCM", "Front"]
    for ctl in controls:
        if direction == "up":
            if run(["amixer","-q","sset",ctl,"5%+","unmute"]): return True
        elif direction == "down":
            if run(["amixer","-q","sset",ctl,"5%-","unmute"]): return True
        elif direction == "mute":
            if run(["amixer","-q","sset",ctl,"toggle"]): return True
    return False

class Handler(BaseHTTPRequestHandler):
    server_version = "OrbisTVRemote/1.0"
    def log_message(self, fmt, *args):
        return

    def send_json(self, code, payload):
        data = json.dumps(payload, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type","application/json; charset=utf-8")
        self.send_header("Content-Length",str(len(data)))
        self.send_header("Cache-Control","no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/","/index.html"):
            data=HTML.encode()
            self.send_response(200)
            self.send_header("Content-Type","text/html; charset=utf-8")
            self.send_header("Content-Length",str(len(data)))
            self.send_header("Cache-Control","no-store")
            self.end_headers()
            self.wfile.write(data)
        elif self.path == "/health":
            self.send_json(200,{"ok":True})
        else:
            self.send_error(404)

    def do_POST(self):
        if self.path != "/api/action":
            self.send_error(404); return
        try:
            n=int(self.headers.get("Content-Length","0"))
            if n <= 0 or n > 16384: raise ValueError()
            body=json.loads(self.rfile.read(n))
        except Exception:
            self.send_json(400,{"ok":False,"error":"Pedido inválido"}); return
        if str(body.get("pin","")) != self.server.pin:
            self.send_json(403,{"ok":False,"error":"PIN incorreto"}); return

        action=body.get("action","")
        ok=False
        try:
            if action=="ping":
                ok=True
            elif action=="move":
                dx=max(-250,min(250,int(body.get("dx",0))))
                dy=max(-250,min(250,int(body.get("dy",0))))
                ok=xdotool("mousemove_relative","--",str(dx),str(dy))
            elif action=="click":
                ok=xdotool("click","1")
            elif action=="double_click":
                ok=xdotool("click","--repeat","2","--delay","90","1")
            elif action=="right_click":
                ok=xdotool("click","3")
            elif action=="scroll_up":
                ok=xdotool("click","--repeat","3","4")
            elif action=="scroll_down":
                ok=xdotool("click","--repeat","3","5")
            elif action=="key":
                key=str(body.get("key",""))
                ok=key in ALLOWED_KEYS and xdotool("key","--clearmodifiers",key)
            elif action=="text":
                text=str(body.get("text",""))[:500]
                if not text:
                    ok=True
                elif shutil_which("xclip"):
                    ok=run(["xclip","-selection","clipboard"],text) and xdotool("key","--clearmodifiers","ctrl+v")
                else:
                    ok=xdotool("type","--clearmodifiers","--delay","1","--",text)
            elif action=="volume_up":
                ok=change_volume("up")
            elif action=="volume_down":
                ok=change_volume("down")
            elif action=="mute":
                ok=change_volume("mute")
        except Exception:
            ok=False
        self.send_json(200 if ok else 500,{"ok":ok,"error":None if ok else "Comando não executado"})

def shutil_which(name):
    for d in os.environ.get("PATH","").split(os.pathsep):
        p=os.path.join(d,name)
        if os.path.isfile(p) and os.access(p,os.X_OK):
            return p
    return None

def pid_alive():
    try:
        pid=int(PID_FILE.read_text().strip())
        os.kill(pid,0)
        return pid
    except Exception:
        return None

def start():
    ensure_state()
    pid=pid_alive()
    if pid:
        print_status()
        return
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    log=open(LOG_FILE,"ab",buffering=0)
    p=subprocess.Popen([sys.executable,os.path.abspath(__file__),"--serve"],
                       stdin=subprocess.DEVNULL,stdout=log,stderr=log,
                       start_new_session=True,env={**os.environ,"DISPLAY":DISPLAY})
    PID_FILE.write_text(str(p.pid)+"\n")
    time.sleep(0.5)
    if p.poll() is not None:
        print("Falha ao iniciar controle remoto. Veja", LOG_FILE)
        raise SystemExit(1)
    print_status()

def stop():
    pid=pid_alive()
    if pid:
        try: os.kill(pid,signal.SIGTERM)
        except OSError: pass
        time.sleep(0.3)
    try: PID_FILE.unlink()
    except FileNotFoundError: pass
    print("Controle remoto parado.")

def print_status():
    pin=ensure_state()
    state="ATIVO" if pid_alive() else "INATIVO"
    print("ORBIS TV REMOTE •",state)
    print(f"Abra no celular: http://{get_ip()}:{PORT}")
    print("PIN:",pin)
    print("Touchpad, teclado e volume: disponíveis.")
    print("Giroscópio: disponível quando o navegador do celular permitir o sensor.")

def serve():
    pin=ensure_state()
    server=ThreadingHTTPServer(("0.0.0.0",PORT),Handler)
    server.pin=pin
    def end(*_):
        server.shutdown()
    signal.signal(signal.SIGTERM,end)
    signal.signal(signal.SIGINT,end)
    try: server.serve_forever()
    finally:
        server.server_close()

if __name__=="__main__":
    arg=sys.argv[1] if len(sys.argv)>1 else "--status"
    if arg in ("--start","start","--boot","boot"): start()
    elif arg in ("--stop","stop"): stop()
    elif arg in ("--restart","restart"): stop(); start()
    elif arg in ("--serve","serve"): serve()
    else: print_status()
