#!/bin/sh
set -u

LOGFILE="/var/log/orbis.log"
MIN_YEAR=2024

log() {
  mkdir -p /var/log 2>/dev/null || true
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf agora)" "$*" >> "$LOGFILE" 2>/dev/null || true
}

current_year() {
  date +%Y 2>/dev/null | awk '{print int($1)}'
}

clock_is_valid() {
  year="$(current_year)"
  [ -n "$year" ] && [ "$year" -ge "$MIN_YEAR" ]
}

wait_for_network() {
  count=0
  while [ "$count" -lt 20 ]; do
    if ip -4 route show default 2>/dev/null | grep -q '^default '; then
      return 0
    fi
    count=$((count + 1))
    sleep 1
  done
  return 1
}

sync_with_ntpd() {
  command -v ntpd >/dev/null 2>&1 || return 1
  for server in pool.ntp.org time.cloudflare.com time.google.com; do
    if ntpd -q -n -p "$server" >/tmp/orbis-time.log 2>&1; then
      clock_is_valid && return 0
    fi
  done
  return 1
}

save_hardware_clock() {
  command -v hwclock >/dev/null 2>&1 || return 0
  hwclock -w >/dev/null 2>&1 || true
}

if clock_is_valid; then
  [ "${1:-}" = "--quiet" ] || printf 'Relógio já está válido: %s\n' "$(date 2>/dev/null)"
  exit 0
fi

[ "${1:-}" = "--quiet" ] || printf '%s\n' 'Relógio incorreto. Tentando sincronização segura pela internet...'

if ! wait_for_network; then
  log 'Sincronização de horário: rede indisponível.'
  [ "${1:-}" = "--quiet" ] || printf '%s\n' 'Sem rota de internet para sincronizar o relógio.'
  exit 1
fi

if sync_with_ntpd; then
  save_hardware_clock
  log "Horário sincronizado: $(date 2>/dev/null)"
  [ "${1:-}" = "--quiet" ] || printf 'Horário sincronizado: %s\n' "$(date 2>/dev/null)"
  exit 0
fi

log 'Sincronização de horário falhou.'
[ "${1:-}" = "--quiet" ] || {
  printf '%s\n' 'Não foi possível sincronizar automaticamente.'
  printf '%s\n' 'Ajuste manualmente com: date -s "AAAA-MM-DD HH:MM:SS"'
}
exit 1
