#!/bin/sh
set -eu

REPO_URL="https://github.com/PrimalSword/Jogoia.git"
BRANCH="main"
CHECKOUT="/opt/orbis-src"
CORE="$CHECKOUT/orbis/core"
RELEASE_FILE="/etc/orbis-release"
LOGFILE="/var/log/orbis.log"
BACKUP_DIR="/opt/orbis-backup"
VERSION="0.4.1"
FILES="orbis orbis-wifi orbis-install orbis-update orbis-log orbis-login orbis-tetris orbis-doctor orbis-keyboard"

mkdir -p /opt /var/log /usr/local/bin "$BACKUP_DIR"
mount -o remount,rw / 2>/dev/null || true

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf agora)" "$*" >> "$LOGFILE" 2>/dev/null || true
}

repair_apk() {
  mkdir -p /etc/apk
  [ -f /etc/apk/repositories ] || : > /etc/apk/repositories

  if ! grep -Eq '^[^#].*/v3\.24/main([[:space:]]*)$' /etc/apk/repositories 2>/dev/null; then
    printf '%s\n' 'https://dl-cdn.alpinelinux.org/alpine/v3.24/main' >> /etc/apk/repositories
  fi
  if ! grep -Eq '^[^#].*/v3\.24/community([[:space:]]*)$' /etc/apk/repositories 2>/dev/null; then
    printf '%s\n' 'https://dl-cdn.alpinelinux.org/alpine/v3.24/community' >> /etc/apk/repositories
  fi

  if [ -f /etc/apk/world ]; then
    awk '
      {
        line=$0
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
        if (line == "linux-firmware-iwlwifi") next
        if (line == "linux-firmware-rtlwifi") next
        print $0
      }
    ' /etc/apk/world > /tmp/orbis-world.clean
    cat /tmp/orbis-world.clean > /etc/apk/world
  fi

  if grep -Eq '^[[:space:]]*linux-firmware-(iwlwifi|rtlwifi)[[:space:]]*$' /etc/apk/world 2>/dev/null; then
    printf '%s\n' 'Falha ao limpar dependências incompatíveis do APK world.'
    exit 1
  fi

  apk update
}

ensure_git() {
  if command -v git >/dev/null 2>&1; then return 0; fi
  printf '%s\n' 'Git não está instalado. Corrigindo repositórios e instalando...'
  repair_apk
  apk add --force-broken-world git ca-certificates
  update-ca-certificates 2>/dev/null || true
  command -v git >/dev/null 2>&1 || { printf '%s\n' 'Falha ao instalar o Git.'; exit 1; }
}

backup_current() {
  rm -rf "$BACKUP_DIR/current"
  mkdir -p "$BACKUP_DIR/current/bin"
  for file in $FILES; do
    [ -f "/usr/local/bin/$file" ] && cp -p "/usr/local/bin/$file" "$BACKUP_DIR/current/bin/$file"
  done
  [ -f "$RELEASE_FILE" ] && cp -p "$RELEASE_FILE" "$BACKUP_DIR/current/orbis-release"
}

restore_backup() {
  printf '%s\n' 'Falha detectada. Restaurando versão anterior...'
  if [ -d "$BACKUP_DIR/current/bin" ]; then
    for file in "$BACKUP_DIR/current/bin"/*; do
      [ -f "$file" ] || continue
      install -m 0755 "$file" "/usr/local/bin/${file##*/}"
    done
  fi
  [ -f "$BACKUP_DIR/current/orbis-release" ] && cp "$BACKUP_DIR/current/orbis-release" "$RELEASE_FILE"
  sync
  log 'Atualização falhou; backup restaurado.'
}

trap 'restore_backup' INT TERM HUP

printf '%s\n' 'ORBIS OS - ATUALIZAÇÃO SEGURA'
printf '%s\n' '============================================='

ensure_git

ping -c 1 -W 5 github.com >/dev/null 2>&1 || {
  printf '%s\n' 'Sem acesso ao GitHub. Confira o Wi-Fi.'
  exit 1
}

backup_current

if [ -d "$CHECKOUT/.git" ]; then
  printf '%s\n' 'Atualizando repositório existente...'
  git -C "$CHECKOUT" fetch origin "$BRANCH"
  git -C "$CHECKOUT" reset --hard "origin/$BRANCH"
else
  printf '%s\n' 'Clonando o OrbisOS pela primeira vez...'
  rm -rf "$CHECKOUT"
  git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$CHECKOUT"
fi

[ -d "$CORE" ] || { restore_backup; printf '%s\n' 'Estrutura orbis/core não encontrada.'; exit 1; }

for file in $FILES; do
  [ -f "$CORE/$file" ] || { restore_backup; printf 'Arquivo ausente: %s\n' "$file"; exit 1; }
done

for file in $FILES; do
  install -m 0755 "$CORE/$file" "/usr/local/bin/$file"
done

for file in $FILES; do
  [ -x "/usr/local/bin/$file" ] || { restore_backup; printf 'Falha ao validar: %s\n' "$file"; exit 1; }
done

COMMIT="$(git -C "$CHECKOUT" rev-parse HEAD)"
SHORT="$(git -C "$CHECKOUT" rev-parse --short HEAD)"
cat > "$RELEASE_FILE" <<EOF
ORBIS_VERSION=$VERSION
ORBIS_BRANCH=$BRANCH
ORBIS_COMMIT=$COMMIT
ORBIS_REPOSITORY=$REPO_URL
UPDATED_AT=$(date -Iseconds 2>/dev/null || date)
EOF

sync
trap - INT TERM HUP
log "Orbis atualizado com segurança para $COMMIT"
printf '\nOrbis atualizado com sucesso.\n'
printf 'Versão instalada: %s\n' "$VERSION"
printf 'Commit instalado: %s\n' "$SHORT"
printf '%s\n' 'Backup da versão anterior mantido em /opt/orbis-backup/current.'