#!/bin/sh
set -eu

BASE="/var/lib/orbis/web"
PIDFILE="/run/orbis-web.pid"
LOGFILE="/var/log/orbis-web.log"
PORT="${ORBIS_WEB_PORT:-8080}"
mkdir -p "$BASE" /run /var/log

html_escape() { printf '%s' "$1" | sed 's/&/\&amp;/g;s/</\&lt;/g;s/>/\&gt;/g;s/"/\&quot;/g'; }

render() {
  mem_total="$(awk '/MemTotal/ {printf "%.0f", $2/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  mem_avail="$(awk '/MemAvailable/ {printf "%.0f", $2/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  load="$(awk '{print $1" "$2" "$3}' /proc/loadavg 2>/dev/null || printf '?')"
  uptime_s="$(cut -d. -f1 /proc/uptime 2>/dev/null || printf 0)"
  uptime_h="$((uptime_s / 3600))h $(((uptime_s % 3600) / 60))m"
  disk="$(df -hP / 2>/dev/null | awk 'NR==2 {print $3" / "$2" ("$5")"}')"
  ip="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | paste -sd, -)"
  [ -n "$ip" ] || ip="desconectado"
  ssid="$(iw dev 2>/dev/null | awk '$1=="Interface" {i=$2} END{if(i) print i}' | xargs -r -I{} sh -c "iw dev {} link 2>/dev/null | awk -F': ' '/SSID:/ {print \\$2; exit}'" 2>/dev/null || true)"
  [ -n "$ssid" ] || ssid="desconectado"
  jobs_total="$(find /var/lib/orbis/jobs -maxdepth 1 -name '*.job' 2>/dev/null | wc -l | tr -d ' ')"
  jobs_enabled="$(find /var/lib/orbis/jobs -maxdepth 1 -name '*.enabled' 2>/dev/null | wc -l | tr -d ' ')"
  version="desconhecida"; commit="desconhecido"
  if [ -f /etc/orbis-release ]; then . /etc/orbis-release; version="${ORBIS_VERSION:-desconhecida}"; commit="${ORBIS_COMMIT:-desconhecido}"; fi
  commit="$(printf '%s' "$commit" | cut -c1-8)"
  now="$(date '+%d/%m/%Y %H:%M:%S' 2>/dev/null || true)"
  cat > "$BASE/index.html" <<EOF
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="10"><title>Orbis OS</title><style>body{font-family:system-ui;background:#0b0f14;color:#eaf2ff;margin:0;padding:24px}.wrap{max-width:760px;margin:auto}.head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #526070;padding-bottom:12px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin-top:18px}.card{background:#141b24;border:1px solid #273444;border-radius:12px;padding:16px}.k{font-size:12px;color:#93a4b8;text-transform:uppercase}.v{font-size:22px;margin-top:6px;word-break:break-word}.ok{color:#8ef0b1}.foot{color:#7f8da0;font-size:12px;margin-top:18px}</style></head><body><div class="wrap"><div class="head"><div><div class="k">ORBIS OS</div><div class="v ok">ONLINE</div></div><div>v$(html_escape "$version") · $(html_escape "$commit")</div></div><div class="grid"><div class="card"><div class="k">Memória</div><div class="v">${mem_avail} MB livres / ${mem_total} MB</div></div><div class="card"><div class="k">Carga</div><div class="v">$(html_escape "$load")</div></div><div class="card"><div class="k">Uptime</div><div class="v">$(html_escape "$uptime_h")</div></div><div class="card"><div class="k">Disco</div><div class="v">$(html_escape "$disk")</div></div><div class="card"><div class="k">Wi-Fi</div><div class="v">$(html_escape "$ssid")</div></div><div class="card"><div class="k">IP</div><div class="v">$(html_escape "$ip")</div></div><div class="card"><div class="k">Automações</div><div class="v">${jobs_enabled} ativas / ${jobs_total}</div></div><div class="card"><div class="k">Relógio</div><div class="v">$(html_escape "$now")</div></div></div><div class="foot">Painel somente leitura · atualização automática a cada 10 segundos</div></div></body></html>
EOF
}

worker() { while :; do render; sleep 10; done; }
start() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then printf 'Painel já está ativo na porta %s.\n' "$PORT"; return 0; fi
  render
  busybox httpd -p "$PORT" -h "$BASE" >>"$LOGFILE" 2>&1
  worker >>"$LOGFILE" 2>&1 & echo $! > "$PIDFILE"
  printf 'Painel iniciado: http://%s:%s\n' "$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)" "$PORT"
}
stop() { [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null || true; rm -f "$PIDFILE"; killall httpd 2>/dev/null || true; printf 'Painel parado.\n'; }
status() { if pgrep httpd >/dev/null 2>&1; then printf 'ATIVO porta %s\n' "$PORT"; else printf 'INATIVO\n'; fi; }
case "${1:-menu}" in --start|start) start;; --stop|stop) stop;; --status|status) status;; --boot) start >/dev/null 2>&1 || true;; *) clear; printf 'ORBIS WEB\n─────────────────────────────────────────────\n1 Iniciar  2 Parar  3 Status  0 Voltar\n web › '; read -r c; case "$c" in 1) start;;2) stop;;3) status;;esac; printf '\nEnter...'; read -r _ || true;; esac
