#!/bin/sh
set -eu

REPOS="/etc/apk/repositories"
LOGFILE="/var/log/orbis-mirror.log"
STATE_DIR="/var/lib/orbis-mirror"
WIFI_FILE="$STATE_DIR/wifi-target"
DISPLAY_NUM="${ORBIS_MIRROR_DISPLAY:-:0}"
MODE="${ORBIS_MIRROR_MODE:-800x600}"
SIZE="${ORBIS_MIRROR_SIZE:-640}"
FPS="${ORBIS_MIRROR_FPS:-30}"
BITRATE="${ORBIS_MIRROR_BITRATE:-1500000}"
VIDEO_BUFFER="${ORBIS_MIRROR_BUFFER:-100}"
TRANSPORT="${ORBIS_MIRROR_TRANSPORT:-usb}"
AUDIO_MODE="${ORBIS_MIRROR_AUDIO:-auto}"
DIM_PHONE="${ORBIS_MIRROR_DIM_PHONE:-0}"
REAL_SCREEN_OFF="${ORBIS_MIRROR_REAL_SCREEN_OFF:-0}"
STRETCH="${ORBIS_MIRROR_STRETCH:-1}"
MAX_RETRIES="${ORBIS_MIRROR_RETRIES:-10}"
ADB_SERIAL=""
XORG_OWNED=0
OPENBOX_OWNED=0
OLD_BRIGHTNESS=""
OLD_BRIGHTNESS_MODE=""
OLD_TIMEOUT=""
PHONE_TUNED=0

say(){ printf '%s\n' "$*"; }
log(){ mkdir -p /var/log; printf '%s %s\n' "$(date '+%F %T' 2>/dev/null || printf agora)" "$*" >> "$LOGFILE" 2>/dev/null || true; }
need_root(){ [ "$(id -u)" -eq 0 ] || { say 'Execute como root.'; exit 1; }; }
supports(){ scrcpy --help 2>/dev/null | grep -q -- "$1"; }
with_timeout(){ if command -v timeout >/dev/null 2>&1; then timeout "$1" "${@:2}"; else shift; "$@"; fi; }
adb_cmd(){ if [ -n "$ADB_SERIAL" ]; then adb -s "$ADB_SERIAL" "$@"; else adb "$@"; fi; }
usb_serial(){ adb devices 2>/dev/null | awk 'NR>1 && $2=="device" && $1 !~ /:/ {print $1; exit}'; }

ensure_repos(){
  mkdir -p /etc/apk
  [ -f "$REPOS" ] || : > "$REPOS"
  grep -Eq '^[^#].*/v3\.24/main' "$REPOS" 2>/dev/null || echo 'https://dl-cdn.alpinelinux.org/alpine/v3.24/main' >> "$REPOS"
  grep -Eq '^[^#].*/v3\.24/community' "$REPOS" 2>/dev/null || echo 'https://dl-cdn.alpinelinux.org/alpine/v3.24/community' >> "$REPOS"
}

prepare(){
  need_root
  ensure_repos
  mkdir -p "$STATE_DIR"
  apk update >/dev/null 2>&1 || true
  missing=""
  command -v adb >/dev/null 2>&1 || missing="$missing android-tools-adb"
  command -v Xorg >/dev/null 2>&1 || missing="$missing xorg-server"
  command -v openbox >/dev/null 2>&1 || missing="$missing openbox"
  command -v xrandr >/dev/null 2>&1 || missing="$missing xrandr"
  [ -z "$missing" ] || apk add --force-broken-world $missing
  if ! command -v scrcpy >/dev/null 2>&1; then
    apk add --force-broken-world scrcpy >/dev/null 2>&1 || \
      apk add --force-broken-world --repository 'https://dl-cdn.alpinelinux.org/alpine/v3.23/community' scrcpy >/dev/null 2>&1 || {
        say 'Não consegui instalar o scrcpy.'; exit 1;
      }
  fi
  say 'ORBIS Mirror preparado.'
  scrcpy --version 2>/dev/null | head -n1 || true
}

wait_usb(){
  adb start-server >/dev/null 2>&1 || true
  serial="$(usb_serial || true)"
  if [ -n "$serial" ]; then ADB_SERIAL="$serial"; return 0; fi
  say 'Conecte o celular por USB e aceite a Depuração USB.'
  n=0
  while [ "$n" -lt 30 ]; do
    serial="$(usb_serial || true)"
    if [ -n "$serial" ]; then ADB_SERIAL="$serial"; return 0; fi
    n=$((n+1)); sleep 1
  done
  say 'Celular USB não encontrado.'; exit 1
}

phone_wifi_ip(){
  adb_cmd shell ip -4 route 2>/dev/null | tr -d '\r' | awk '$0 ~ / dev (wlan[0-9]*|wifi[0-9]*)/ {for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'
}

wifi_setup(){
  need_root
  command -v adb >/dev/null 2>&1 || prepare
  mkdir -p "$STATE_DIR"
  wait_usb
  ip="$(phone_wifi_ip || true)"
  [ -n "$ip" ] || { say 'Não achei o IP Wi-Fi do celular.'; exit 1; }
  target="$ip:5555"
  say "Preparando ADB por Wi-Fi em $target..."
  adb_cmd tcpip 5555 >/dev/null 2>&1 || { say 'O Android recusou adb tcpip.'; exit 1; }
  sleep 2
  timeout 6 adb connect "$target" >/dev/null 2>&1 || true
  if timeout 4 adb -s "$target" get-state 2>/dev/null | grep -q '^device$'; then
    printf '%s\n' "$target" > "$WIFI_FILE"
    say 'Wi-Fi configurado. Pode tirar o cabo e usar: orbis-mirror --wifi'
  else
    say 'Não consegui fechar a conexão ADB via Wi-Fi.'; exit 1
  fi
}

connect_wifi(){
  [ -r "$WIFI_FILE" ] || { say 'Wi-Fi não configurado. Rode --wifi-setup com USB.'; exit 1; }
  target="$(cat "$WIFI_FILE")"
  timeout 6 adb connect "$target" >/dev/null 2>&1 || true
  timeout 4 adb -s "$target" get-state 2>/dev/null | grep -q '^device$' || { say 'ADB Wi-Fi caiu. Rode --wifi-setup novamente.'; exit 1; }
  ADB_SERIAL="$target"
}

wait_phone(){ case "$TRANSPORT" in wifi) connect_wifi ;; *) wait_usb ;; esac; }

configure_display(){
  export DISPLAY="$DISPLAY_NUM"
  out="$(xrandr --query 2>/dev/null | awk '$2=="connected" {print $1}' | grep -E '^(VGA|HDMI|DP|DVI)' | head -n1 || true)"
  [ -n "$out" ] || out="$(xrandr --query 2>/dev/null | awk '$2=="connected" {print $1; exit}' || true)"
  [ -n "$out" ] || return 0
  for internal in $(xrandr --query 2>/dev/null | awk '$2=="connected" {print $1}' | grep -E '^(LVDS|eDP|DSI)' || true); do
    [ "$internal" = "$out" ] || xrandr --output "$internal" --off >/dev/null 2>&1 || true
  done
  xrandr --output "$out" --mode "$MODE" --primary --pos 0x0 >/dev/null 2>&1 || \
    xrandr --output "$out" --mode 640x480 --primary --pos 0x0 >/dev/null 2>&1 || true
}

start_graphics(){
  export DISPLAY="$DISPLAY_NUM"
  if ! xrandr --query >/dev/null 2>&1; then
    rm -f /tmp/.X0-lock 2>/dev/null || true
    Xorg "$DISPLAY_NUM" vt1 -keeptty -nolisten tcp >>"$LOGFILE" 2>&1 &
    XORG_PID=$!; XORG_OWNED=1
    n=0
    while [ "$n" -lt 40 ]; do xrandr --query >/dev/null 2>&1 && break; n=$((n+1)); sleep 0.25; done
  fi
  xrandr --query >/dev/null 2>&1 || { say 'Xorg não iniciou.'; exit 1; }
  configure_display
  if ! pgrep -x openbox >/dev/null 2>&1; then openbox >>"$LOGFILE" 2>&1 & OPENBOX_PID=$!; OPENBOX_OWNED=1; sleep 1; fi
}

save_phone_display(){
  [ "$DIM_PHONE" = "1" ] || return 0
  OLD_BRIGHTNESS="$(adb_cmd shell settings get system screen_brightness 2>/dev/null | tr -d '\r' || true)"
  OLD_BRIGHTNESS_MODE="$(adb_cmd shell settings get system screen_brightness_mode 2>/dev/null | tr -d '\r' || true)"
  OLD_TIMEOUT="$(adb_cmd shell settings get system screen_off_timeout 2>/dev/null | tr -d '\r' || true)"
  adb_cmd shell settings put system screen_brightness_mode 0 >/dev/null 2>&1 || true
  adb_cmd shell settings put system screen_brightness 20 >/dev/null 2>&1 || true
  adb_cmd shell settings put system screen_off_timeout 2147483647 >/dev/null 2>&1 || true
  PHONE_TUNED=1
}

restore_phone_display(){
  [ "$PHONE_TUNED" = "1" ] || return 0
  [ -n "$OLD_BRIGHTNESS_MODE" ] && adb_cmd shell settings put system screen_brightness_mode "$OLD_BRIGHTNESS_MODE" >/dev/null 2>&1 || true
  [ -n "$OLD_BRIGHTNESS" ] && adb_cmd shell settings put system screen_brightness "$OLD_BRIGHTNESS" >/dev/null 2>&1 || true
  [ -n "$OLD_TIMEOUT" ] && adb_cmd shell settings put system screen_off_timeout "$OLD_TIMEOUT" >/dev/null 2>&1 || true
}

stop_graphics(){
  restore_phone_display || true
  [ "$OPENBOX_OWNED" -eq 0 ] || kill "$OPENBOX_PID" 2>/dev/null || true
  [ "$XORG_OWNED" -eq 0 ] || kill "$XORG_PID" 2>/dev/null || true
}

run_once(){
  args="--serial=$ADB_SERIAL --video-codec=h264 --max-size=$SIZE --max-fps=$FPS --video-bit-rate=$BITRATE --fullscreen --no-control"
  supports --video-buffer && args="$args --video-buffer=$VIDEO_BUFFER"
  supports --window-borderless && args="$args --window-borderless"
  supports --disable-screensaver && args="$args --disable-screensaver"
  supports --no-window-aspect-ratio-lock && args="$args --no-window-aspect-ratio-lock"
  supports --window-width && args="$args --window-width=800 --window-height=600"
  if [ "$STRETCH" = "1" ]; then
    # scrcpy 4.0: força preenchimento da janela, sem preservar 20:9 do celular.
    args="$args --render-fit=stretched"
  fi
  [ "$REAL_SCREEN_OFF" = "0" ] || args="$args --turn-screen-off"
  [ "$AUDIO_MODE" = "off" ] && supports --no-audio && args="$args --no-audio"
  log "scrcpy $args"
  # shellcheck disable=SC2086
  nice -n -5 scrcpy $args >>"$LOGFILE" 2>&1
}

reconnect(){
  if [ "$TRANSPORT" = "wifi" ]; then connect_wifi; else serial="$(usb_serial || true)"; [ -n "$serial" ] || return 1; ADB_SERIAL="$serial"; fi
}

run_mirror(){
  need_root
  command -v scrcpy >/dev/null 2>&1 || prepare
  wait_phone
  adb_cmd shell input keyevent KEYCODE_WAKEUP >/dev/null 2>&1 || true
  adb_cmd shell wm dismiss-keyguard >/dev/null 2>&1 || true
  [ -x /usr/local/bin/orbis-audio ] && /usr/local/bin/orbis-audio --clean >>"$LOGFILE" 2>&1 || true
  start_graphics
  trap 'stop_graphics' EXIT INT TERM HUP
  export DISPLAY="$DISPLAY_NUM" SDL_VIDEODRIVER=x11 SDL_AUDIODRIVER=alsa
  save_phone_display
  say 'ORBIS MIRROR • fullscreen 800x600 • preenchimento total da CRT'
  tries=0
  while :; do
    code=0; run_once || code=$?
    [ "$code" -eq 0 ] && break
    tries=$((tries+1)); [ "$tries" -le "$MAX_RETRIES" ] || break
    say "Link caiu. Reconectando ($tries/$MAX_RETRIES)..."; sleep 2
    reconnect || true
  done
  stop_graphics; trap - EXIT INT TERM HUP
}

status(){
  say 'ORBIS MIRROR • STATUS'
  scrcpy --version 2>/dev/null | head -n1 || true
  printf 'Wi-Fi salvo: '; [ -r "$WIFI_FILE" ] && cat "$WIFI_FILE" || say 'não configurado'
  printf 'Render-fit stretched: '; supports --render-fit && say 'sim' || say 'não'
  printf 'No aspect lock: '; supports --no-window-aspect-ratio-lock && say 'sim' || say 'não'
}

help(){
  cat <<'EOF'
Uso:
  orbis-mirror --wifi
  orbis-mirror --wifi-setup
  orbis-mirror --usb
  orbis-mirror --screen-on
  orbis-mirror --dim-screen
  orbis-mirror --real-screen-off
  orbis-mirror --no-stretch
  orbis-mirror --lite
  orbis-mirror --quality
  orbis-mirror --status
EOF
}

DO_SETUP=0
DO_STATUS=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --wifi) TRANSPORT=wifi; VIDEO_BUFFER=160 ;;
    --wifi-setup) DO_SETUP=1 ;;
    --usb) TRANSPORT=usb ;;
    --screen-on) DIM_PHONE=0; REAL_SCREEN_OFF=0 ;;
    --dim-screen) DIM_PHONE=1; REAL_SCREEN_OFF=0 ;;
    --real-screen-off) REAL_SCREEN_OFF=1; DIM_PHONE=0 ;;
    --no-stretch) STRETCH=0 ;;
    --stretch) STRETCH=1 ;;
    --video-only) AUDIO_MODE=off ;;
    --lite) SIZE=480; FPS=24; BITRATE=900000; VIDEO_BUFFER=120 ;;
    --quality) SIZE=800; FPS=30; BITRATE=2000000; VIDEO_BUFFER=80 ;;
    --status) DO_STATUS=1 ;;
    --prepare) prepare; exit 0 ;;
    -h|--help|help) help; exit 0 ;;
    *) say "Opção desconhecida: $1"; help; exit 1 ;;
  esac
  shift
done
[ "$DO_SETUP" -eq 0 ] || { wifi_setup; exit 0; }
[ "$DO_STATUS" -eq 0 ] || { status; exit 0; }
run_mirror
