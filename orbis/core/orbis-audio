#!/bin/sh
set -eu

REPOS="/etc/apk/repositories"
LOGFILE="/var/log/orbis-audio.log"

say(){ printf '%s\n' "$*"; }
need_root(){ [ "$(id -u)" -eq 0 ] || { say 'Execute como root.'; exit 1; }; }
ensure_repositories(){
  mkdir -p /etc/apk
  [ -f "$REPOS" ] || : > "$REPOS"
  grep -Eq '^[^#].*/v3\.24/main([[:space:]]*)$' "$REPOS" 2>/dev/null || printf '%s\n' 'https://dl-cdn.alpinelinux.org/alpine/v3.24/main' >> "$REPOS"
  grep -Eq '^[^#].*/v3\.24/community([[:space:]]*)$' "$REPOS" 2>/dev/null || printf '%s\n' 'https://dl-cdn.alpinelinux.org/alpine/v3.24/community' >> "$REPOS"
}
ensure_packages(){
  ensure_repositories
  if ! apk info -e alsa-utils >/dev/null 2>&1; then
    say 'Instalando ALSA...'
    apk update
    apk add --force-broken-world alsa-utils
  fi
}
load_modules(){
  command -v modprobe >/dev/null 2>&1 || return 0
  modprobe snd_hda_intel 2>>"$LOGFILE" || true
  modprobe snd_intel8x0 2>>"$LOGFILE" || true
  modprobe snd_pcm 2>>"$LOGFILE" || true
}
unmute(){
  command -v alsactl >/dev/null 2>&1 && alsactl init >/dev/null 2>&1 || true
  command -v amixer >/dev/null 2>&1 || return 0
  for ctl in Master PCM Speaker Headphone Front; do
    amixer -q sset "$ctl" 85% unmute >/dev/null 2>&1 || true
  done
  amixer -q sset 'Auto-Mute Mode' Disabled >/dev/null 2>&1 || true
}
prepare(){
  need_root
  ensure_packages
  load_modules
  unmute
  if [ -r /proc/asound/cards ] && grep -Eq '^[[:space:]]*[0-9]+[[:space:]]+\[' /proc/asound/cards; then
    say 'Áudio ALSA preparado.'
    cat /proc/asound/cards
  else
    say 'Nenhuma placa de áudio ALSA foi detectada.'
    exit 1
  fi
}
status(){
  say 'ORBIS AUDIO  •  STATUS'
  if [ -r /proc/asound/cards ]; then cat /proc/asound/cards; else say 'Sem /proc/asound/cards'; fi
  say ''
  command -v aplay >/dev/null 2>&1 && aplay -l 2>/dev/null || true
  say ''
  command -v amixer >/dev/null 2>&1 && amixer sget Master 2>/dev/null || true
}
test_audio(){
  prepare
  say ''
  say 'Teste estéreo: você deve ouvir LEFT e RIGHT/tons alternados.'
  speaker-test -c 2 -t wav -l 1 || speaker-test -c 2 -t sine -l 1 || true
}
help(){
  cat <<'EOF'
Uso:
  orbis-audio --prepare   instala ALSA, carrega o driver e desmuta a saída
  orbis-audio --test      faz o preparo e toca um teste estéreo
  orbis-audio --status    mostra placas e saídas detectadas

IMPORTANTE:
  VGA não transporta áudio. O som precisa sair fisicamente pela saída de
  fones/P2 do Itautec para a entrada AUDIO IN do VGA2AV, ou diretamente para
  os RCA vermelho/branco da TV com um cabo P2 -> 2 RCA.
EOF
}

case "${1:-}" in
  --prepare|prepare) prepare ;;
  --test|test) test_audio ;;
  --status|status) status ;;
  --help|-h|help|'') help ;;
  *) help; exit 1 ;;
esac
