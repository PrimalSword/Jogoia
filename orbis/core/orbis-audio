#!/bin/sh
set -eu

REPOS="/etc/apk/repositories"
LOGFILE="/var/log/orbis-audio.log"

say(){ printf '%s\n' "$*"; }
need_root(){ [ "$(id -u)" -eq 0 ] || { say 'Execute como root.'; exit 1; }; }
ensure_repositories(){
  mkdir -p /etc/apk
  [ -f "$REPOS" ] || : > "$REPOS"
  grep -Eq '^[^#].*/v3\.24/main([[:space:]]*)$' "$REPOS" 2>/dev/null || printf '%s\n' 'https://dl-cdn.alpinelinux.org/alpine/v3.24/main' >> "$REPOS"
  grep -Eq '^[^#].*/v3\.24/community([[:space:]]*)$' "$REPOS" 2>/dev/null || printf '%s\n' 'https://dl-cdn.alpinelinux.org/alpine/v3.24/community' >> "$REPOS"
}
ensure_packages(){
  ensure_repositories
  if ! apk info -e alsa-utils >/dev/null 2>&1; then
    say 'Instalando ALSA...'
    apk update
    apk add --force-broken-world alsa-utils
  fi
}
load_modules(){
  command -v modprobe >/dev/null 2>&1 || return 0
  modprobe snd_hda_intel 2>>"$LOGFILE" || true
  modprobe snd_intel8x0 2>>"$LOGFILE" || true
  modprobe snd_pcm 2>>"$LOGFILE" || true
}
disable_audio_powersave(){
  [ -w /sys/module/snd_hda_intel/parameters/power_save ] && printf '0\n' > /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || true
  [ -w /sys/module/snd_hda_intel/parameters/power_save_controller ] && printf 'N\n' > /sys/module/snd_hda_intel/parameters/power_save_controller 2>/dev/null || true
}
set_output_levels(){
  command -v amixer >/dev/null 2>&1 || return 0
  amixer -q sset Master 85% unmute >/dev/null 2>&1 || true
  amixer -q sset PCM 100% unmute >/dev/null 2>&1 || true
  amixer -q sset Headphone 90% unmute >/dev/null 2>&1 || true
  amixer -q sset Front 90% unmute >/dev/null 2>&1 || true
  amixer -q sset Speaker mute >/dev/null 2>&1 || true
  amixer -q sset 'Auto-Mute Mode' Disabled >/dev/null 2>&1 || true
}
mute_noise_sources(){
  command -v amixer >/dev/null 2>&1 || return 0
  for ctl in \
    'Mic' 'Internal Mic' 'Front Mic' 'Rear Mic' \
    'Mic Boost' 'Internal Mic Boost' 'Front Mic Boost' \
    'Capture' 'Line' 'Line In' 'Aux' 'CD' \
    'Beep' 'PC Speaker' 'Loopback'; do
    amixer -q sset "$ctl" 0% mute >/dev/null 2>&1 || \
      amixer -q sset "$ctl" mute >/dev/null 2>&1 || true
  done
  amixer -q sset 'Loopback Mixing' Disabled >/dev/null 2>&1 || true
  amixer -q sset 'Analog Loopback' Disabled >/dev/null 2>&1 || true
}
clean_audio(){
  need_root
  ensure_packages
  load_modules
  command -v alsactl >/dev/null 2>&1 && alsactl init >/dev/null 2>&1 || true
  disable_audio_powersave
  mute_noise_sources
  set_output_levels
  command -v alsactl >/dev/null 2>&1 && alsactl store >/dev/null 2>&1 || true
  say 'Perfil anti-BZZ aplicado: P2 priorizado, entradas/loopbacks mutados e power-save de áudio desativado.'
}
prepare(){
  clean_audio
  if [ -r /proc/asound/cards ] && grep -Eq '^[[:space:]]*[0-9]+[[:space:]]+\[' /proc/asound/cards; then
    say 'Áudio ALSA preparado.'
    cat /proc/asound/cards
  else
    say 'Nenhuma placa de áudio ALSA foi detectada.'
    exit 1
  fi
}
status(){
  say 'ORBIS AUDIO  •  STATUS'
  if [ -r /proc/asound/cards ]; then cat /proc/asound/cards; else say 'Sem /proc/asound/cards'; fi
  say ''
  command -v aplay >/dev/null 2>&1 && aplay -l 2>/dev/null || true
  say ''
  if command -v amixer >/dev/null 2>&1; then
    for ctl in Master PCM Headphone Speaker Mic 'Mic Boost' Capture Line Beep; do
      amixer sget "$ctl" 2>/dev/null | sed -n '1,8p' || true
    done
  fi
  if [ -r /sys/module/snd_hda_intel/parameters/power_save ]; then
    printf 'snd_hda_intel power_save: %s\n' "$(cat /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || printf '?')"
  fi
}
test_audio(){
  clean_audio
  say ''
  say 'Teste estéreo: você deve ouvir LEFT e RIGHT/tons alternados.'
  speaker-test -c 2 -t wav -l 1 || speaker-test -c 2 -t sine -l 1 || true
}
help(){
  cat <<'EOF_HELP'
Uso:
  orbis-audio --prepare   instala ALSA e aplica o perfil anti-BZZ
  orbis-audio --clean     aplica o perfil anti-BZZ para saída P2
  orbis-audio --test      aplica o perfil e toca um teste estéreo
  orbis-audio --status    mostra placas, saídas e controles relevantes

Perfil anti-BZZ:
  prioriza PCM/Headphone, muta microfones, boosts, captura, line-in, beep e
  loopbacks quando existirem e desativa o power-save do snd_hda_intel.

IMPORTANTE:
  O perfil de áudio NÃO altera mais codecs, cache ou fila de vídeo. Isso evita
  regressão de fluidez no Atom. VGA não transporta áudio: o som sai pelo P2.
EOF_HELP
}

case "${1:-}" in
  --prepare|prepare) prepare ;;
  --clean|clean) clean_audio ;;
  --test|test) test_audio ;;
  --status|status) status ;;
  --help|-h|help|'') help ;;
  *) help; exit 1 ;;
esac
