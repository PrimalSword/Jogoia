#!/bin/sh

DEFAULT_VERSION="0.3.0"
VERSION="$DEFAULT_VERSION"
COMMIT="embutido-na-ISO"
BIN_DIR="/usr/local/bin"

if [ -f /etc/orbis-release ]; then
  . /etc/orbis-release
  VERSION="${ORBIS_VERSION:-$DEFAULT_VERSION}"
  COMMIT="${ORBIS_COMMIT:-desconhecido}"
fi
SHORT_COMMIT="$(printf '%s' "$COMMIT" | cut -c1-8)"

power_status() {
  BAT_DIR=""
  AC_ONLINE=""

  for path in /sys/class/power_supply/BAT*; do
    [ -d "$path" ] || continue
    BAT_DIR="$path"
    break
  done

  for path in /sys/class/power_supply/*; do
    [ -d "$path" ] || continue
    [ -f "$path/type" ] || continue
    TYPE="$(cat "$path/type" 2>/dev/null || true)"
    case "$TYPE" in
      Mains|USB|USB_C|USB_PD)
        if [ -f "$path/online" ]; then
          VALUE="$(cat "$path/online" 2>/dev/null || printf 0)"
          [ "$VALUE" = "1" ] && AC_ONLINE="1"
        fi
        ;;
    esac
  done

  if [ -n "$BAT_DIR" ]; then
    CAPACITY="$(cat "$BAT_DIR/capacity" 2>/dev/null || true)"
    STATUS="$(cat "$BAT_DIR/status" 2>/dev/null || true)"

    case "$STATUS" in
      Charging) LABEL="carregando" ;;
      Discharging) LABEL="na bateria" ;;
      Full) LABEL="carregada" ;;
      "Not charging") LABEL="conectada à energia" ;;
      *)
        if [ "$AC_ONLINE" = "1" ]; then
          LABEL="conectada à energia"
        else
          LABEL="na bateria"
        fi
        ;;
    esac

    if [ -n "$CAPACITY" ]; then
      printf '%s%% (%s)' "$CAPACITY" "$LABEL"
    else
      printf '%s' "$LABEL"
    fi
  elif [ "$AC_ONLINE" = "1" ]; then
    printf '%s' 'conectada à energia'
  else
    printf '%s' 'indisponível'
  fi
}

show_status() {
  MEM_MB="$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  CPU="$(awk -F: '/model name/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null)"
  [ -n "$CPU" ] || CPU="$(uname -m)"
  IP="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | paste -sd, -)"
  [ -n "$IP" ] || IP="desconectada"
  POWER="$(power_status)"

  clear
  printf '%s\n' '============================================='
  printf '%s\n' '                  ORBIS OS'
  printf '                  versão %s\n' "$VERSION"
  printf '%s\n' '============================================='
  printf 'Sistema....... iniciado\n'
  printf 'Processador... %s\n' "$CPU"
  printf 'Memória....... %s MB\n' "$MEM_MB"
  printf 'Energia....... %s\n' "$POWER"
  printf 'Rede.......... %s\n' "$IP"
  printf 'Hostname...... %s\n' "$(hostname 2>/dev/null || printf orbis)"
  printf 'Commit........ %s\n' "$SHORT_COMMIT"
  printf 'Terminal...... pronto\n'
  printf '%s\n\n' '============================================='
}

run_orbis_command() {
  command_name="$1"
  command_path="$BIN_DIR/$command_name"

  if [ ! -x "$command_path" ]; then
    printf 'Componente indisponível ou sem permissão: %s\n' "$command_path"
    return 1
  fi

  "$command_path"
}

show_status
[ "${1:-}" = "--status" ] && exit 0

while :; do
  printf '%s\n' '1 - Jogar Tetris'
  printf '%s\n' '2 - Configurar Wi-Fi'
  printf '%s\n' '3 - Instalar no cartão/disco'
  printf '%s\n' '4 - Atualizar pelo Git'
  printf '%s\n' '5 - Ver logs / rolar histórico'
  printf '%s\n' '6 - Atualizar status'
  printf '%s\n' '7 - Reiniciar'
  printf '%s\n' '8 - Desligar'
  printf '%s\n' '0 - Voltar ao terminal'
  printf '%s' 'Escolha: '
  read -r choice

  case "$choice" in
    1) run_orbis_command orbis-tetris; show_status ;;
    2) run_orbis_command orbis-wifi; printf '\nPressione Enter para voltar...'; read -r _; show_status ;;
    3) run_orbis_command orbis-install; printf '\nPressione Enter para voltar...'; read -r _; show_status ;;
    4) run_orbis_command orbis-update; printf '\nPressione Enter para voltar...'; read -r _; show_status ;;
    5) run_orbis_command orbis-log; show_status ;;
    6) show_status ;;
    7) reboot ;;
    8) poweroff ;;
    0) exit 0 ;;
    *) printf 'Opção inválida.\n' ;;
  esac
done
