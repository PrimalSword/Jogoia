#!/bin/sh

VERSION="0.2"

show_status() {
  MEM_MB="$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  CPU="$(awk -F: '/model name/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null)"
  [ -n "$CPU" ] || CPU="$(uname -m)"
  IP="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | paste -sd, -)"
  [ -n "$IP" ] || IP="desconectada"

  clear
  printf '%s\n' '============================================='
  printf '%s\n' '                  ORBIS OS'
  printf '                  versão %s\n' "$VERSION"
  printf '%s\n' '============================================='
  printf 'Sistema....... iniciado\n'
  printf 'Processador... %s\n' "$CPU"
  printf 'Memória....... %s MB\n' "$MEM_MB"
  printf 'Rede.......... %s\n' "$IP"
  printf 'Hostname...... %s\n' "$(hostname 2>/dev/null || printf orbis)"
  printf 'Terminal...... pronto\n'
  printf '%s\n\n' '============================================='
}

show_status

while :; do
  printf '%s\n' '1 - Configurar Wi-Fi'
  printf '%s\n' '2 - Instalar no cartão/disco'
  printf '%s\n' '3 - Atualizar Orbis'
  printf '%s\n' '4 - Atualizar status'
  printf '%s\n' '5 - Reiniciar'
  printf '%s\n' '6 - Desligar'
  printf '%s'   'Escolha: '
  read -r choice

  case "$choice" in
    1) orbis-wifi; printf '\nPressione Enter para voltar...'; read -r _; show_status ;;
    2) orbis-install; printf '\nPressione Enter para voltar...'; read -r _; show_status ;;
    3) orbis-update; printf '\nPressione Enter para voltar...'; read -r _; show_status ;;
    4) show_status ;;
    5) reboot ;;
    6) poweroff ;;
    *) printf 'Opção inválida.\n' ;;
  esac
done
