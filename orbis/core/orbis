#!/bin/sh

DEFAULT_VERSION="0.4.0"
VERSION="$DEFAULT_VERSION"
COMMIT="embutido-na-ISO"
BIN_DIR="/usr/local/bin"

if [ -f /etc/orbis-release ]; then
  . /etc/orbis-release
  VERSION="${ORBIS_VERSION:-$DEFAULT_VERSION}"
  COMMIT="${ORBIS_COMMIT:-desconhecido}"
fi
SHORT_COMMIT="$(printf '%s' "$COMMIT" | cut -c1-8)"

power_status() {
  BAT_DIR=""
  AC_ONLINE=""
  for path in /sys/class/power_supply/BAT*; do [ -d "$path" ] && { BAT_DIR="$path"; break; }; done
  for path in /sys/class/power_supply/*; do
    [ -d "$path" ] || continue
    [ -f "$path/type" ] || continue
    TYPE="$(cat "$path/type" 2>/dev/null || true)"
    case "$TYPE" in Mains|USB|USB_C|USB_PD) [ -f "$path/online" ] && [ "$(cat "$path/online" 2>/dev/null)" = "1" ] && AC_ONLINE="1" ;; esac
  done
  if [ -n "$BAT_DIR" ]; then
    CAPACITY="$(cat "$BAT_DIR/capacity" 2>/dev/null || true)"
    STATUS="$(cat "$BAT_DIR/status" 2>/dev/null || true)"
    case "$STATUS" in Charging) LABEL="carregando" ;; Discharging) LABEL="na bateria" ;; Full) LABEL="carregada" ;; "Not charging") LABEL="conectada à energia" ;; *) [ "$AC_ONLINE" = "1" ] && LABEL="conectada à energia" || LABEL="na bateria" ;; esac
    [ -n "$CAPACITY" ] && printf '%s%% (%s)' "$CAPACITY" "$LABEL" || printf '%s' "$LABEL"
  elif [ "$AC_ONLINE" = "1" ]; then printf '%s' 'conectada à energia'; else printf '%s' 'indisponível'; fi
}

wifi_status() {
  WIFI_IFACE=""
  for path in /sys/class/net/*; do
    [ -e "$path" ] || continue
    iface="${path##*/}"
    case "$iface" in wlan*|wlp*) WIFI_IFACE="$iface"; break ;; esac
  done
  WIFI_SSID="desconectada"; WIFI_SIGNAL="indisponível"
  [ -n "$WIFI_IFACE" ] || return 0
  LINK="$(iw dev "$WIFI_IFACE" link 2>/dev/null || true)"
  SSID="$(printf '%s\n' "$LINK" | awk -F': ' '/SSID:/ {print $2; exit}')"
  SIGNAL="$(printf '%s\n' "$LINK" | awk '/signal:/ {print $2 " " $3; exit}')"
  [ -n "$SSID" ] && WIFI_SSID="$SSID"
  [ -n "$SIGNAL" ] && WIFI_SIGNAL="$SIGNAL"
}

show_status() {
  MEM_MB="$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  CPU="$(awk -F: '/model name/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null)"
  [ -n "$CPU" ] || CPU="$(uname -m)"
  IP="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | paste -sd, -)"
  [ -n "$IP" ] || IP="desconectada"
  POWER="$(power_status)"
  wifi_status
  clear
  printf '%s\n' '============================================='
  printf '%s\n' '                  ORBIS OS'
  printf '                  versão %s\n' "$VERSION"
  printf '%s\n' '============================================='
  printf 'Sistema....... iniciado\n'
  printf 'Processador... %s\n' "$CPU"
  printf 'Memória....... %s MB\n' "$MEM_MB"
  printf 'Energia....... %s\n' "$POWER"
  printf 'Wi-Fi......... %s\n' "$WIFI_SSID"
  printf 'Sinal......... %s\n' "$WIFI_SIGNAL"
  printf 'IP............ %s\n' "$IP"
  printf 'Hostname...... %s\n' "$(hostname 2>/dev/null || printf orbis)"
  printf 'Commit........ %s\n' "$SHORT_COMMIT"
  printf 'Terminal...... pronto\n'
  printf '%s\n\n' '============================================='
}

run_orbis_command() {
  command_path="$BIN_DIR/$1"
  [ -x "$command_path" ] || { printf 'Componente indisponível: %s\n' "$command_path"; return 1; }
  "$command_path"
}

pause_menu() { printf '\nPressione Enter para voltar...'; read -r _ || true; }

show_status
[ "${1:-}" = "--status" ] && exit 0

while :; do
  printf '%s\n' '1 - Jogar Tetris'
  printf '%s\n' '2 - Configurar Wi-Fi'
  printf '%s\n' '3 - Configurar teclado'
  printf '%s\n' '4 - Diagnóstico / Orbis Doctor'
  printf '%s\n' '5 - Atualizar pelo Git'
  printf '%s\n' '6 - Ver logs'
  printf '%s\n' '7 - Instalar no cartão/disco'
  printf '%s\n' '8 - Atualizar status'
  printf '%s\n' '9 - Reiniciar'
  printf '%s\n' '10 - Desligar'
  printf '%s\n' '0 - Voltar ao terminal'
  printf '%s' 'Escolha: '
  read -r choice || exit 0
  case "$choice" in
    1) run_orbis_command orbis-tetris; show_status ;;
    2) run_orbis_command orbis-wifi; pause_menu; show_status ;;
    3) run_orbis_command orbis-keyboard; pause_menu; show_status ;;
    4) run_orbis_command orbis-doctor; pause_menu; show_status ;;
    5) run_orbis_command orbis-update; pause_menu; show_status ;;
    6) run_orbis_command orbis-log; show_status ;;
    7) run_orbis_command orbis-install; pause_menu; show_status ;;
    8) show_status ;;
    9) reboot ;;
    10) poweroff ;;
    0) exit 0 ;;
    *) printf 'Opção inválida.\n' ;;
  esac
done
