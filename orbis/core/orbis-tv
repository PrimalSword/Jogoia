#!/bin/sh
set -eu

REPOS="/etc/apk/repositories"
STATE_DIR="/var/lib/orbis-tv"
PROFILE_DIR="$STATE_DIR/firefox"
LAST_URL="$STATE_DIR/last-url"
LOGFILE="/var/log/orbis-tv.log"
DEFAULT_MODE="${ORBIS_TV_MODE:-800x600}"
DISPLAY_NUM="${ORBIS_TV_DISPLAY:-:0}"
EXTERNAL_ONLY="${ORBIS_TV_EXTERNAL_ONLY:-1}"

TV_PACKAGES="xorg-server openbox firefox-esr ublock-origin dbus dbus-x11 xrandr xinput mesa-dri-gallium mesa-gl font-dejavu xf86-input-libinput xf86-input-evdev xf86-input-synaptics xf86-video-intel xf86-video-vesa xf86-video-fbdev eudev eudev-openrc alpine-conf"

say() { printf '%s\n' "$*"; }
need_root() {
  [ "$(id -u)" -eq 0 ] || { say 'Execute como root.'; exit 1; }
}
ensure_repositories() {
  mkdir -p /etc/apk
  [ -f "$REPOS" ] || : > "$REPOS"
  grep -Eq '^[^#].*/v3\.24/main([[:space:]]*)$' "$REPOS" 2>/dev/null || printf '%s\n' 'https://dl-cdn.alpinelinux.org/alpine/v3.24/main' >> "$REPOS"
  grep -Eq '^[^#].*/v3\.24/community([[:space:]]*)$' "$REPOS" 2>/dev/null || printf '%s\n' 'https://dl-cdn.alpinelinux.org/alpine/v3.24/community' >> "$REPOS"
}
runtime_ready() {
  command -v Xorg >/dev/null 2>&1 && \
  command -v openbox >/dev/null 2>&1 && \
  command -v xrandr >/dev/null 2>&1 && \
  command -v xinput >/dev/null 2>&1 && \
  { command -v firefox-esr >/dev/null 2>&1 || command -v firefox >/dev/null 2>&1; }
}
ensure_adblock() {
  ensure_repositories
  apk info -e ublock-origin >/dev/null 2>&1 && return 0
  say 'ORBIS TV  •  instalando uBlock Origin para bloquear anúncios...'
  if apk update >/dev/null 2>&1 && apk add --force-broken-world ublock-origin; then
    say 'uBlock Origin instalado. O Firefox abrirá com bloqueio de anúncios.'
    return 0
  fi
  say 'Aviso: não foi possível instalar o uBlock Origin agora; o modo TV continuará sem ele.'
  return 0
}
ensure_video_stack() {
  ensure_repositories
  missing=""
  for pkg in xf86-video-intel xf86-video-vesa xf86-video-fbdev; do
    apk info -e "$pkg" >/dev/null 2>&1 || missing="$missing $pkg"
  done
  if [ -n "$missing" ]; then
    say "Instalando drivers de vídeo legado:$missing"
    apk update
    apk add --force-broken-world $missing
  fi
  command -v modprobe >/dev/null 2>&1 && modprobe i915 2>>"$LOGFILE" || true
}
write_input_config() {
  mkdir -p /etc/X11/xorg.conf.d
  cat > /etc/X11/xorg.conf.d/40-orbis-input.conf <<'EOF'
Section "InputClass"
    Identifier "Orbis keyboard"
    MatchIsKeyboard "on"
    Driver "evdev"
EndSection

Section "InputClass"
    Identifier "Orbis pointer"
    MatchIsPointer "on"
    Driver "evdev"
EndSection

Section "InputClass"
    Identifier "Orbis touchpad"
    MatchIsTouchpad "on"
    Driver "synaptics"
    Option "TapButton1" "1"
EndSection
EOF
}
ensure_input_stack() {
  ensure_repositories
  missing=""
  for pkg in eudev eudev-openrc alpine-conf xf86-input-libinput xf86-input-evdev xf86-input-synaptics xinput; do
    apk info -e "$pkg" >/dev/null 2>&1 || missing="$missing $pkg"
  done
  if [ -n "$missing" ]; then
    say "Instalando suporte de teclado/touchpad:$missing"
    apk update
    apk add --force-broken-world $missing
  fi

  if command -v setup-devd >/dev/null 2>&1; then
    if ! command -v udevadm >/dev/null 2>&1 || ! rc-service eudev status >/dev/null 2>&1; then
      say 'Configurando eudev para os dispositivos de entrada...'
      setup-devd udev >/tmp/orbis-tv-devd.log 2>&1 || {
        say 'Falha ao configurar eudev.'
        cat /tmp/orbis-tv-devd.log 2>/dev/null || true
        return 1
      }
    fi
  fi

  if command -v rc-service >/dev/null 2>&1; then
    rc-service eudev start >/dev/null 2>&1 || true
    rc-service eudev-trigger start >/dev/null 2>&1 || true
  fi
  command -v udevadm >/dev/null 2>&1 && {
    udevadm trigger --subsystem-match=input >/dev/null 2>&1 || true
    udevadm settle --timeout=5 >/dev/null 2>&1 || true
  }
  if command -v modprobe >/dev/null 2>&1; then
    modprobe i8042 2>>"$LOGFILE" || true
    modprobe psmouse 2>>"$LOGFILE" || true
    modprobe usbhid 2>>"$LOGFILE" || true
    modprobe hid_generic 2>>"$LOGFILE" || true
  fi
  write_input_config
}
write_firefox_profile() {
  mkdir -p "$STATE_DIR" "$PROFILE_DIR" /var/log
  chmod 700 "$STATE_DIR" "$PROFILE_DIR" 2>/dev/null || true
  cat > "$PROFILE_DIR/user.js" <<'EOF'
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.newtabpage.enabled", false);
user_pref("browser.startup.page", 0);
user_pref("toolkit.cosmeticAnimations.enabled", false);
user_pref("ui.prefersReducedMotion", 1);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("browser.discovery.enabled", false);
user_pref("browser.search.suggest.enabled", false);
user_pref("browser.urlbar.speculativeConnect.enabled", false);
user_pref("network.prefetch-next", false);
user_pref("network.dns.disablePrefetch", true);
user_pref("media.autoplay.default", 0);
user_pref("dom.ipc.processCount", 1);
user_pref("dom.ipc.processCount.webIsolated", 1);
user_pref("browser.tabs.unloadOnLowMemory", true);
user_pref("image.animation_mode", "once");
EOF
}
enable_performance_mode() {
  # O Atom antigo sofre mais com pico de memória que com armazenamento.
  # Cria swap comprimida em RAM se zram estiver disponível.
  if command -v modprobe >/dev/null 2>&1; then modprobe zram 2>>"$LOGFILE" || true; fi
  if [ -b /dev/zram0 ] && ! grep -q '^/dev/zram0 ' /proc/swaps 2>/dev/null; then
    mem_kb="$(awk '/MemTotal/ {print $2; exit}' /proc/meminfo 2>/dev/null || printf 0)"
    size_bytes=$((mem_kb * 1024 / 4))
    [ "$size_bytes" -gt 536870912 ] && size_bytes=536870912
    [ "$size_bytes" -lt 134217728 ] && size_bytes=134217728
    if command -v zramctl >/dev/null 2>&1; then
      zramctl /dev/zram0 --reset >/dev/null 2>&1 || true
      zramctl /dev/zram0 --size "$size_bytes" >/dev/null 2>&1 || true
    elif [ -w /sys/block/zram0/disksize ]; then
      printf '%s\n' "$size_bytes" > /sys/block/zram0/disksize 2>/dev/null || true
    fi
    if [ "$(cat /sys/block/zram0/disksize 2>/dev/null || printf 0)" -gt 0 ] 2>/dev/null; then
      mkswap /dev/zram0 >/dev/null 2>&1 || true
      swapon -p 100 /dev/zram0 >/dev/null 2>&1 || true
    fi
  fi

  # Mantém o Atom no clock máximo enquanto o modo TV estiver aberto.
  for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -w "$gov" ] || continue
    printf '%s\n' performance > "$gov" 2>/dev/null || true
  done
}
prepare() {
  need_root
  ensure_repositories
  if ! runtime_ready; then
    say 'ORBIS TV  •  preparando ambiente gráfico mínimo'
    say 'Instalando Xorg, Firefox ESR, uBlock Origin, vídeo Intel legado e suporte completo de teclado/touchpad.'
    apk update
    apk add --force-broken-world $TV_PACKAGES
  fi
  ensure_adblock
  write_firefox_profile
  ensure_video_stack
  ensure_input_stack
  enable_performance_mode
  say 'Modo TV preparado; vídeo, entrada, AdBlock e otimizações verificados.'
}
normalize_url() {
  case "$1" in
    http://*|https://*|file://*) printf '%s\n' "$1" ;;
    *) printf 'https://%s\n' "$1" ;;
  esac
}
choose_url() {
  requested="${1:-}"
  if [ -n "$requested" ]; then normalize_url "$requested"; return; fi
  previous=""
  [ -r "$LAST_URL" ] && previous="$(cat "$LAST_URL" 2>/dev/null || true)"
  if [ -n "$previous" ]; then printf 'Site [%s]: ' "$previous" >&2; else printf 'Digite o site: ' >&2; fi
  read -r entered || true
  [ -n "${entered:-}" ] || entered="$previous"
  [ -n "$entered" ] || { say 'Nenhum site informado.' >&2; exit 1; }
  normalize_url "$entered"
}
configure_display() {
  export DISPLAY="$DISPLAY_NUM"
  mode="$DEFAULT_MODE"
  out="$(xrandr --query 2>/dev/null | awk '$2=="connected" {print $1}' | grep -E '^(VGA|HDMI|DP|DVI)' | head -n1 || true)"
  [ -n "$out" ] || out="$(xrandr --query 2>/dev/null | awk '$2=="connected" {print $1; exit}' || true)"
  [ -n "$out" ] || return 0

  if [ "$EXTERNAL_ONLY" = "1" ]; then
    for internal in $(xrandr --query 2>/dev/null | awk '$2=="connected" {print $1}' | grep -E '^(LVDS|eDP|DSI)' || true); do
      [ "$internal" = "$out" ] || xrandr --output "$internal" --off >/dev/null 2>&1 || true
    done
  fi

  if xrandr --query 2>/dev/null | awk -v o="$out" -v m="$mode" '
      $1==o && $2=="connected" {inside=1; next}
      inside && $1 ~ /^[A-Za-z]/ {inside=0}
      inside && $1==m {found=1}
      END {exit found?0:1}'; then
    xrandr --output "$out" --mode "$mode" --primary --pos 0x0 >/dev/null 2>&1 || true
  elif xrandr --query 2>/dev/null | grep -q '^[[:space:]]*640x480'; then
    xrandr --output "$out" --mode 640x480 --primary --pos 0x0 >/dev/null 2>&1 || true
  fi
}
start_xorg() {
  : > "$LOGFILE" 2>/dev/null || true
  rm -f /tmp/.X0-lock 2>/dev/null || true
  ensure_video_stack
  ensure_input_stack
  Xorg "$DISPLAY_NUM" vt1 -keeptty -nolisten tcp >>"$LOGFILE" 2>&1 &
  XORG_PID=$!
  export XORG_PID
  count=0
  while [ "$count" -lt 40 ]; do
    if DISPLAY="$DISPLAY_NUM" xrandr --query >/dev/null 2>&1; then return 0; fi
    kill -0 "$XORG_PID" 2>/dev/null || break
    count=$((count + 1))
    sleep 0.25
  done
  say 'Xorg não iniciou corretamente.'
  grep -E '\(EE\)|\(WW\)|driver|Driver|screen|Screen|i915|intel|vesa|fbdev|input|Input' "$LOGFILE" 2>/dev/null | tail -n 60 || tail -n 60 "$LOGFILE" 2>/dev/null || true
  kill "$XORG_PID" 2>/dev/null || true
  wait "$XORG_PID" 2>/dev/null || true
  return 1
}
validate_input() {
  export DISPLAY="$DISPLAY_NUM"
  list="$(xinput list 2>/dev/null || true)"
  physical="$(printf '%s\n' "$list" | grep -vi 'XTEST' || true)"
  keyboard=0
  pointer=0
  printf '%s\n' "$physical" | grep -Eqi 'slave[[:space:]]+keyboard|keyboard.*slave' && keyboard=1 || true
  printf '%s\n' "$physical" | grep -Eqi 'slave[[:space:]]+pointer|pointer.*slave|touchpad|mouse|synaptics' && pointer=1 || true

  if [ "$keyboard" -eq 1 ] && [ "$pointer" -eq 1 ]; then
    say 'Entrada Xorg: teclado OK, ponteiro OK.'
    return 0
  fi

  say 'SEGURANÇA: o Xorg abriu, mas não reconheceu todos os dispositivos de entrada.'
  say "Teclado: $([ "$keyboard" -eq 1 ] && printf OK || printf AUSENTE)"
  say "Mouse/touchpad: $([ "$pointer" -eq 1 ] && printf OK || printf AUSENTE)"
  say 'O Firefox NÃO será aberto. O X será fechado automaticamente para não prender a máquina.'
  printf '%s\n' "$list" >> "$LOGFILE" 2>/dev/null || true
  grep -E 'input|Input|keyboard|mouse|touchpad|synaptics|libinput|evdev|udev' "$LOGFILE" 2>/dev/null | tail -n 60 || true
  return 1
}
stop_xorg() {
  [ -n "${OPENBOX_PID:-}" ] && kill "$OPENBOX_PID" 2>/dev/null || true
  [ -n "${XORG_PID:-}" ] && kill "$XORG_PID" 2>/dev/null || true
  [ -n "${OPENBOX_PID:-}" ] && wait "$OPENBOX_PID" 2>/dev/null || true
  [ -n "${XORG_PID:-}" ] && wait "$XORG_PID" 2>/dev/null || true
}
run_tv() {
  need_root
  runtime_ready || prepare
  ensure_adblock
  ensure_video_stack
  ensure_input_stack
  write_firefox_profile
  enable_performance_mode
  mkdir -p "$STATE_DIR" "$PROFILE_DIR" /var/log
  url="$(choose_url "${1:-}")"
  printf '%s\n' "$url" > "$LAST_URL"
  export DISPLAY="$DISPLAY_NUM"
  export HOME=/root
  export MOZ_DISABLE_AUTO_SAFE_MODE=1
  export MOZ_CRASHREPORTER_DISABLE=1
  export MOZ_NO_REMOTE=1
  trap 'stop_xorg' EXIT INT TERM HUP

  say "Abrindo: $url"
  say "Modo de vídeo preferido: $DEFAULT_MODE"
  [ "$EXTERNAL_ONLY" = "1" ] && say 'Saída externa exclusiva: a tela do notebook será desligada no Xorg.'
  command -v chvt >/dev/null 2>&1 && chvt 1 2>/dev/null || true
  start_xorg
  configure_display
  if ! validate_input; then
    stop_xorg
    trap - EXIT INT TERM HUP
    say 'Voltando ao terminal sem abrir o Firefox.'
    return 1
  fi

  openbox >>"$LOGFILE" 2>&1 &
  OPENBOX_PID=$!
  export OPENBOX_PID
  sleep 1
  say 'Para sair do navegador: Alt+F4 ou Ctrl+Q.'
  browser="$(command -v firefox-esr || command -v firefox)"
  if command -v dbus-run-session >/dev/null 2>&1; then
    nice -n -5 dbus-run-session -- "$browser" --no-remote --profile "$PROFILE_DIR" --kiosk "$url" >>"$LOGFILE" 2>&1 || code=$?
  else
    nice -n -5 "$browser" --no-remote --profile "$PROFILE_DIR" --kiosk "$url" >>"$LOGFILE" 2>&1 || code=$?
  fi
  code="${code:-0}"
  stop_xorg
  trap - EXIT INT TERM HUP
  [ "$code" -eq 0 ] || { say "Firefox encerrou com código $code. Veja $LOGFILE"; return "$code"; }
  say 'Modo TV encerrado. Voltando ao terminal.'
}
status() {
  say 'ORBIS TV  •  STATUS'
  if runtime_ready; then say 'Runtime gráfico: instalado'; else say 'Runtime gráfico: incompleto'; fi
  printf 'uBlock Origin: '; apk info -e ublock-origin >/dev/null 2>&1 && say 'instalado' || say 'ausente'
  printf 'eudev: '; command -v udevadm >/dev/null 2>&1 && say 'instalado' || say 'ausente'
  printf 'i915: '; lsmod 2>/dev/null | grep -q '^i915' && say 'carregado' || say 'não carregado'
  printf 'psmouse: '; lsmod 2>/dev/null | grep -q '^psmouse' && say 'carregado' || say 'não carregado'
  printf 'zram: '; grep -q '^/dev/zram0 ' /proc/swaps 2>/dev/null && say 'ativa' || say 'inativa/indisponível'
  printf 'saída externa exclusiva: %s\n' "$EXTERNAL_ONLY"
  for pkg in xf86-video-intel xf86-video-vesa xf86-video-fbdev xf86-input-libinput xf86-input-evdev xf86-input-synaptics xinput; do
    apk info -e "$pkg" >/dev/null 2>&1 && printf '%s: instalado\n' "$pkg" || printf '%s: ausente\n' "$pkg"
  done
  if command -v firefox-esr >/dev/null 2>&1; then firefox-esr --version 2>/dev/null || true; elif command -v firefox >/dev/null 2>&1; then firefox --version 2>/dev/null || true; fi
  [ -r "$LAST_URL" ] && printf 'Último site: %s\n' "$(cat "$LAST_URL")" || true
  printf 'Modo preferido: %s\n' "$DEFAULT_MODE"
  [ -s "$LOGFILE" ] && { say 'Últimas linhas do log:'; tail -n 20 "$LOGFILE"; }
}
help() {
  cat <<'EOF'
Uso:
  orbis-tv                  pergunta o site e abre em tela cheia
  orbis-tv exemplo.com      abre o site informado
  orbis-tv --prepare        instala/repara vídeo + teclado + touchpad + AdBlock
  orbis-tv --status         mostra diagnóstico

Modo TV:
  por padrão, quando existe VGA/HDMI externo, a tela interna é desligada.
  Assim o notebook pode ficar fechado enquanto a TV continua ativa,
  desde que a BIOS não imponha suspensão física ao fechar a tampa.

Bloqueio de anúncios:
  o Orbis instala e mantém o uBlock Origin pelo repositório oficial do Alpine.
  Se ele ainda não estiver presente, será instalado antes de abrir o Firefox.

Desempenho:
  ativa zram quando disponível, reduz processos do Firefox e tenta manter
  o processador em modo performance durante a sessão.

Variáveis opcionais:
  ORBIS_TV_MODE=640x480 orbis-tv exemplo.com
  ORBIS_TV_EXTERNAL_ONLY=0 orbis-tv exemplo.com
EOF
}

case "${1:-}" in
  --prepare|prepare|install|--install) prepare ;;
  --status|status) status ;;
  --help|-h|help) help ;;
  *) run_tv "${1:-}" ;;
esac
