#!/bin/sh
set -eu

BASE="/var/lib/orbis/jobs"
LOG_DIR="/var/log/orbis-jobs"
mkdir -p "$BASE" "$LOG_DIR"
chmod 700 "$BASE" "$LOG_DIR" 2>/dev/null || true

valid_name() {
  case "$1" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; *) return 0 ;; esac
}

list_jobs() {
  printf '%s\n' 'AUTOMAÇÕES CADASTRADAS'
  printf '%s\n' '─────────────────────────────────────────────'
  found=0
  for file in "$BASE"/*.job; do
    [ -f "$file" ] || continue
    found=1
    name="${file##*/}"; name="${name%.job}"
    enabled="não"; [ -f "$BASE/$name.enabled" ] && enabled="sim"
    schedule="manual"; command=""
    . "$file"
    printf '%-18s ativa=%-3s modo=%s\n' "$name" "$enabled" "${SCHEDULE:-manual}"
  done
  [ "$found" -eq 1 ] || printf '%s\n' 'Nenhuma automação cadastrada.'
}

run_job() {
  name="$1"
  valid_name "$name" || { printf '%s\n' 'Nome inválido.'; return 1; }
  file="$BASE/$name.job"
  [ -f "$file" ] || { printf '%s\n' 'Automação inexistente.'; return 1; }
  SCHEDULE="manual"; COMMAND=""
  . "$file"
  [ -n "$COMMAND" ] || { printf '%s\n' 'Comando vazio.'; return 1; }
  logfile="$LOG_DIR/$name.log"
  printf '%s INÍCIO %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$COMMAND" >> "$logfile"
  if /bin/sh -c "$COMMAND" >> "$logfile" 2>&1; then
    printf '%s SUCESSO\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "$logfile"
    printf 'Automação %s concluída.\n' "$name"
  else
    code=$?
    printf '%s FALHA código=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$code" >> "$logfile"
    printf 'Automação %s falhou. Veja %s\n' "$name" "$logfile"
    return "$code"
  fi
}

run_boot_jobs() {
  for marker in "$BASE"/*.enabled; do
    [ -f "$marker" ] || continue
    name="${marker##*/}"; name="${name%.enabled}"
    [ -f "$BASE/$name.job" ] || continue
    SCHEDULE="manual"; COMMAND=""
    . "$BASE/$name.job"
    [ "${SCHEDULE:-manual}" = "boot" ] && run_job "$name" || true
  done
}

[ "${1:-}" = "--boot" ] && { run_boot_jobs; exit 0; }
[ "${1:-}" = "--list" ] && { list_jobs; exit 0; }
[ "${1:-}" = "--run" ] && { run_job "${2:-}"; exit $?; }

while :; do
  clear
  printf '%s\n' 'ORBIS AUTOMAÇÕES'
  printf '%s\n' '─────────────────────────────────────────────'
  list_jobs
  printf '\n%s\n' '1 Adicionar  2 Executar  3 Ativar/desativar  4 Remover'
  printf '%s\n' '5 Ver log    0 Voltar'
  printf '%s' ' jobs › '
  read -r choice || exit 0
  case "$choice" in
    1)
      printf 'Nome curto: '; read -r name
      valid_name "$name" || { printf 'Nome inválido.\n'; sleep 2; continue; }
      printf 'Modo [manual/boot]: '; read -r schedule
      case "$schedule" in manual|boot) ;; *) schedule="manual" ;; esac
      printf 'Comando completo: '; read -r command
      [ -n "$command" ] || { printf 'Comando vazio.\n'; sleep 2; continue; }
      printf "SCHEDULE='%s'\nCOMMAND='%s'\n" "$schedule" "$(printf '%s' "$command" | sed "s/'/'\\''/g")" > "$BASE/$name.job"
      chmod 600 "$BASE/$name.job"
      ;;
    2) printf 'Nome: '; read -r name; run_job "$name" || true; printf 'Enter...'; read -r _ ;;
    3) printf 'Nome: '; read -r name; valid_name "$name" || continue; [ -f "$BASE/$name.job" ] || continue; if [ -f "$BASE/$name.enabled" ]; then rm -f "$BASE/$name.enabled"; else : > "$BASE/$name.enabled"; fi ;;
    4) printf 'Nome: '; read -r name; valid_name "$name" || continue; rm -f "$BASE/$name.job" "$BASE/$name.enabled" ;;
    5) printf 'Nome: '; read -r name; valid_name "$name" || continue; tail -n 80 "$LOG_DIR/$name.log" 2>/dev/null || printf 'Sem log.\n'; printf 'Enter...'; read -r _ ;;
    0) exit 0 ;;
  esac
done
